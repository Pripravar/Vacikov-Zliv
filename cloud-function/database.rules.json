    "uzivatele": {
      "$uid": {
        "role":    { ".validate": "auth.token.email === 'arasid33@gmail.com' || root.child('uzivatele').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val()" },
        "blocked": { ".validate": "auth.token.email === 'arasid33@gmail.com' || root.child('uzivatele').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val()" },
        "perms":   { ".validate": "auth.token.email === 'arasid33@gmail.com' || root.child('uzivatele').child(auth.uid).child('role').val() === 'admin'" }
      }
    }
